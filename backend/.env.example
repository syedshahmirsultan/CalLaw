# CalLaw Backend Configuration

# General Application Settings
PROJECT_NAME="CalLaw Legal Assistant"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
# For local SQLite development (default out-of-the-box):
DATABASE_URL="sqlite+aiosqlite:///./callaw.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/callaw_db"

# Clerk Authentication
CLERK_SECRET_KEY="sk_test_..."
# Optional: derived automatically from the publishable key if left empty
CLERK_ISSUER=""
CLERK_PUBLISHABLE_KEY="pk_test_..."
# Optional PEM public key for offline verification:
CLERK_PEM_PUBLIC_KEY=""

# LLM Configuration — REQUIRED. Without a working key the assistant cannot analyze situations.
# Provider: "anthropic" (recommended for accuracy) | "gemini" | "groq" | "openai" | "openrouter"
LLM_PROVIDER="anthropic"
LLM_API_KEY=""
# Leave empty to use the provider default:
#   anthropic -> claude-sonnet-5, gemini -> gemini-2.5-flash, groq -> openai/gpt-oss-120b, openai -> gpt-4.1-mini
LLM_MODEL=""
# Optional custom base URL for OpenAI-compatible providers (leave empty for the provider default):
LLM_BASE_URL=""

# California Legal Search Configuration
# Options: "hybrid", "legislative", "courtlistener", "local_statutes"
LEGAL_SEARCH_MODE="hybrid"
COURTLISTENER_API_KEY=""
